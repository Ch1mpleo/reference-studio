{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "types": ["vite/client"],
    "paths": {
      "@reference-studio/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"],
  "exclude": ["src/client/**/*.test.ts", "src/client/**/*.test.tsx"]
}
